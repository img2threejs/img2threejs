  "spatial_wear_glossary": {
    "core_industry_terms": {
      "surface_imperfections": {"en": "Surface Imperfections", "vi": "Khuyết điểm bề mặt", "def": "Microscopic variations (fingerprints, micro-scratches) that break uniform reflections."},
      "weathering_aging": {"en": "Weathering / Aging", "vi": "Phong hóa / Lão hóa", "def": "Surface degradation from environmental exposure over time."},
      "wear_and_tear": {"en": "Wear and Tear", "vi": "Hao mòn sử dụng", "def": "Physical damage from active use or friction."},
      "edge_wear": {"en": "Edge Wear", "vi": "Mòn cạnh viền", "def": "Damage concentrated along sharp corners or high-exposure edges."},
      "procedural_grunge": {"en": "Procedural Grunge", "vi": "Cáu bẩn thuật toán", "def": "Algorithmically generated dirt distributed via AO or curvature masks."}
    },
    "damage_types_pbr_impact": {
      "oxidation_rust_patina": {
