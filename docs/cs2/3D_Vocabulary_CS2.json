        "lod": {"en": "Level of Detail (LOD)", "vi": "Chi tiết cấp độ", "def": "Lower-poly models at distance"},
        "polygon_budget": {"en": "Polygon Budget", "vi": "Ngân sách đa giác", "def": "Max polygons allowed for object/scene"},
        "occlusion_culling": {"en": "Occlusion Culling", "vi": "Loại trừ che khuất", "def": "Not rendering hidden objects"},
        "frustum_culling": {"en": "Frustum Culling", "vi": "Loại trừ ngoài khung hình", "def": "Not rendering objects outside view"}
      }
