        "well_worn": {"en": "Well-Worn (WW)", "vi": "Mòn nhiều", "def": "Float 0.38-0.45, significant wear"},
        "battle_scarred": {"en": "Battle-Scarred (BS)", "vi": "Chiến tích", "def": "Float 0.45-1.00, heavy damage"},
        "pattern_index": {"en": "Pattern Index", "vi": "Chỉ mẫu", "def": "Integer 0-1000 controlling texture slice"},
        "blue_gem": {"en": "Blue Gem", "vi": "Đá xanh", "def": "Rare Case Hardened pattern, mostly blue"},
        "fade_percentage": {"en": "Fade Percentage", "vi": "Phần trăm Fade", "def": "Color gradient visibility on Fade skins"},
        "doppler_phase": {"en": "Doppler Phase", "vi": "Giai đoạn Doppler", "def": "Color variations in Doppler skins"},
        "stattrak": {"en": "StatTrak™", "vi": "StatTrak™", "def": "Kill counter variant, ~10% drop rate"},
        "souvenir": {"en": "Souvenir", "vi": "Hàng lưu niệm", "def": "Major tournament exclusive with stickers"},
        "sticker": {"en": "Sticker", "vi": "Tem", "def": "Cosmetic item applied to weapons"},
        "sticker_craft": {"en": "Sticker Craft", "vi": "Bộ tem", "def": "Combination of skin with applied stickers"},
        "wear_remap": {"en": "Float Clipping", "vi": "Cắt float", "def": "Per-skin float range restriction"}
      }
    },
    "file_formats": {
      "name": "3D File Formats",
      "terms": {
        "obj": {"en": "OBJ", "vi": "OBJ", "def": "Simple text format for geometry, no animation"},
