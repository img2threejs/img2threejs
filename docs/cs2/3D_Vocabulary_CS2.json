      }
    },
    "animation_rigging": {
      "name": "Animation & Rigging",
      "terms": {
        "skeleton": {"en": "Skeleton", "vi": "Bộ xương", "def": "Hierarchical bone structure for deformation"},
        "bone": {"en": "Bone", "vi": "Xương", "def": "Individual element in skeleton hierarchy"},
        "rigging": {"en": "Rigging", "vi": "Cấp xương", "def": "Creating and binding skeleton to mesh"},
