{
  "metadata": {
    "title": "3D Technical Vocabulary - CS2 Items Dictionary",
    "version": "1.0.0",
    "created": "2026-07-24",
    "sources": ["Valve Developer Community", "CS2 Workshop Docs", "Three.js Docs", "Blender Manual", "Meshy Docs"]
  },
  "categories": {
    "core_3d_modeling": {
      "name": "Core 3D Modeling",
      "terms": {
        "vertex": {"en": "Vertex", "vi": "Đỉnh", "def": "A point in 3D space with X, Y, Z coordinates"},
        "edge": {"en": "Edge", "vi": "Cạnh", "def": "A line connecting two vertices"},
        "face": {"en": "Face", "vi": "Mặt", "def": "A flat surface enclosed by 3+ edges"},
        "polygon": {"en": "Polygon", "vi": "Đa giác", "def": "Generic term for a face (triangles, quads)"},
        "triangle": {"en": "Triangle (Tris)", "vi": "Tam giác", "def": "A 3-sided polygon"},
        "quad": {"en": "Quad", "vi": "Tứ giác", "def": "A 4-sided polygon, preferred for clean topology"},
        "n_gon": {"en": "N-gon", "vi": "N-cạnh", "def": "Polygon with 5+ sides, generally avoided"},
        "mesh": {"en": "Mesh", "vi": "Lưới", "def": "Complete geometric structure of a 3D object"},
        "topology": {"en": "Topology", "vi": "Cấu trúc", "def": "Arrangement and flow of polygons on mesh surface"},
        "edge_loop": {"en": "Edge Loop", "vi": "Vòng cạnh", "def": "Continuous ring of edges flowing around mesh"},
        "retopology": {"en": "Retopology", "vi": "Tái cấu trúc", "def": "Redrawing mesh with cleaner topology"},
        "high_poly": {"en": "High-Poly", "vi": "Đa giác cao", "def": "Mesh with many polygons for detail"},
        "low_poly": {"en": "Low-Poly", "vi": "Đa giác thấp", "def": "Mesh with few polygons, optimized for real-time"},
        "buffer_geometry": {"en": "BufferGeometry", "vi": "BufferGeometry", "def": "Three.js class for custom geometry"}
      }
    },
    "uv_mapping": {
      "name": "UV Mapping & Texturing",
      "terms": {
        "uv_mapping": {"en": "UV Mapping", "vi": "Ánh xạ UV", "def": "Unwrapping 3D surface onto 2D plane for textures"},
        "uv_coordinates": {"en": "UV Coordinates", "vi": "Tọa độ UV", "def": "2D coordinates mapping texture to surface"},
        "uv_seam": {"en": "UV Seam", "vi": "Đường may UV", "def": "Edges where UV map is cut for flattening"},
        "diffuse_map": {"en": "Diffuse/Albedo Map", "vi": "Bản đồ màu", "def": "Base color texture without lighting"},
        "normal_map": {"en": "Normal Map", "vi": "Bản đồ Normal", "def": "RGB texture simulating surface bumps"},
        "roughness_map": {"en": "Roughness Map", "vi": "Bản đồ thô", "def": "Controls surface smoothness (0=smooth, 1=rough)"},
        "metallic_map": {"en": "Metallic Map", "vi": "Bản đồ kim loại", "def": "Defines metallic vs non-metallic areas"},
        "ao_map": {"en": "Ambient Occlusion", "vi": "Che sáng môi trường", "def": "Shows areas where ambient light is blocked"},
        "displacement_map": {"en": "Displacement Map", "vi": "Bản đồ dịch chuyển", "def": "Actually moves vertices for real detail"},
        "emission_map": {"en": "Emission Map", "vi": "Bản đồ phát sáng", "def": "Defines which parts emit light"},
        "mipmapping": {"en": "Mipmapping", "vi": "Mipmap", "def": "Pre-calculated lower-res texture copies"}
      }
    },
    "pbr_materials": {
      "name": "PBR Materials",
      "terms": {
        "pbr": {"en": "PBR (Physically Based Rendering)", "vi": "Render dựa trên vật lý", "def": "Rendering simulating real-world light interaction"},
        "metallic_roughness": {"en": "Metallic/Roughness Workflow", "vi": "Quy trình Kim loại/Thô", "def": "PBR workflow using Base Color + Metallic + Roughness"},
        "specular_glossiness": {"en": "Specular/Glossiness Workflow", "vi": "Quy trình Phản chiếu/Bóng", "def": "Alternative PBR workflow"},
        "base_color": {"en": "Base Color", "vi": "Màu cơ bản", "def": "Fundamental surface color without lighting"},
        "metalness": {"en": "Metalness", "vi": "Độ kim loại", "def": "0=dielectric, 1=metal"},
        "roughness": {"en": "Roughness", "vi": "Độ thô", "def": "0=mirror-smooth, 1=completely rough"},
        "fresnel": {"en": "Fresnel", "vi": "Fresnel", "def": "Reflectivity increases at grazing angles"},
        "energy_conservation": {"en": "Energy Conservation", "vi": "Bảo toàn năng lượng", "def": "Reflected light cannot exceed incoming light"}
      }
    },
