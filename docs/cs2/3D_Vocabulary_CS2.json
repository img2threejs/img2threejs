        "skinned_mesh": {"en": "SkinnedMesh", "vi": "SkinnedMesh", "def": "Three.js mesh deformable by skeleton"}
      }
    },
    "rendering_optimization": {
      "name": "Rendering & Optimization",
      "terms": {
        "draw_call": {"en": "Draw Call", "vi": "Lệnh vẽ", "def": "Single CPU→GPU command to render"},
        "batching": {"en": "Batching", "vi": "Gộp", "def": "Combining objects into fewer draw calls"},
